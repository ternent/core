{
  "name": "@ternent/concord",
  "version": "0.3.0-alpha.0",
  "description": "Command-driven developer runtime for building non-custodial apps on @ternent/ledger",
  "license": "ISC",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./system": {
      "types": "./dist/system/index.d.ts",
      "import": "./dist/system/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "ternent-tooling validate . --built",
    "check": "vp run verify"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@ternent/armour": "workspace:^",
    "@ternent/identity": "workspace:^"
  },
  "devDependencies": {
    "@ternent/tooling": "workspace:*",
    "typescript": "5.9.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "ternent": {
    "profile": "ts-library"
  }
}
