{
  "name": "@ternent/ledger",
  "version": "0.2.0-alpha.0",
  "description": "Standalone signed append-only logs with staging, commits, verification and replay",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternent/core.git",
    "directory": "packages/ledger"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "ternent-tooling validate . --built",
    "check": "vp run verify"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@ternent/identity": "workspace:^"
  },
  "devDependencies": {
    "@ternent/tooling": "workspace:*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "ternent": {
    "profile": "ts-library"
  }
}
