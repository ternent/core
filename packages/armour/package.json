{
  "name": "@ternent/armour",
  "version": "0.3.0-alpha.0",
  "description": "Identity-aware age encryption with text, binary and passphrase helpers",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternent/core.git",
    "directory": "packages/armour"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "ternent-tooling validate . --built",
    "check": "vp run verify"
  },
  "dependencies": {
    "@ternent/identity": "workspace:^",
    "age-encryption": "0.3.1"
  },
  "devDependencies": {
    "@ternent/tooling": "workspace:*",
    "typescript": "5.9.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "ternent": {
    "profile": "ts-library"
  }
}
