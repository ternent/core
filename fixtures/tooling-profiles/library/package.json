{
  "name": "@ternent-fixtures/library",
  "version": "0.0.0-pilot.0",
  "private": true,
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "ternent-tooling validate . --built",
    "check": "vp run verify"
  },
  "devDependencies": {
    "@ternent/tooling": "workspace:*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "ternent": {
    "profile": "ts-library"
  }
}
