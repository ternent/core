{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "enabledManagers": ["npm", "nvm", "nodenv", "github-actions"],
  "ignorePaths": [
    "packages/ledger/**",
    "packages/utils/**",
    "packages/workspace/**",
    "packages/ui/**"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "@typescript/typescript6",
        "@volar/**",
        "@vitejs/plugin-vue",
        "unplugin-vue",
        "vue",
        "vue-tsc"
      ],
      "groupName": "Vue and Vite toolchain"
    }
  ]
}
