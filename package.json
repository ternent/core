{
  "name": "@ternent/core",
  "version": "0.0.1",
  "private": true,
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternent/core.git"
  },
  "type": "module",
  "scripts": {
    "contract": "node scripts/verify/contract.mjs",
    "fmt": "node scripts/verify/scope.mjs fmt",
    "fmt:check": "node scripts/verify/scope.mjs fmt --check",
    "lint": "node scripts/verify/scope.mjs lint --type-aware",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "pnpm --recursive run build",
    "check:artifact": "node scripts/verify/consumers.mjs",
    "check": "node scripts/verify/check.mjs",
    "test:watch": "vp test watch"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "verdaccio": "7.1.2",
    "vite-plus": "1.7.0",
    "vue": "3.5.46"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
