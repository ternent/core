{
  "name": "@ternent/tooling",
  "version": "0.0.0-pilot.0",
  "description": "Portable Ternent package profiles and artifact validation",
  "license": "ISC",
  "bin": {
    "ternent-tooling": "./bin/cli.mjs"
  },
  "files": [
    "src",
    "types",
    "bin",
    "tsconfig",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "types": "./types/config.d.ts",
      "import": "./src/config.mjs"
    },
    "./validation": {
      "types": "./types/validation.d.ts",
      "import": "./src/validation.mjs"
    },
    "./tsconfig/*": "./tsconfig/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "ternent-tooling validate . --built",
    "check:package": "ternent-tooling validate . --built",
    "check:artifact": "ternent-tooling validate . --built",
    "check": "vp run verify"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@volar/language-service": "2.4.28",
    "typescript": "^5.9.3",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "1.3.0"
  },
  "peerDependenciesMeta": {
    "unplugin-vue": {
      "optional": true
    },
    "@vitejs/plugin-vue": {
      "optional": true
    }
  },
  "engines": {
    "node": "^24.21.0"
  },
  "ternent": {
    "profile": "tooling"
  }
}
