{
  "name": "@ternent/app-handshake",
  "version": "0.0.0-pilot.0",
  "private": true,
  "license": "ISC",
  "bin": {
    "ternent-handshake": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.source.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "ternent-tooling validate . --built && node --test smoke/cli.test.mjs",
    "check": "vp run verify"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@ternent/armour": "workspace:^",
    "@ternent/concord": "workspace:^",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@ternent/tooling": "workspace:*",
    "typescript": "5.9.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "ternent": {
    "profile": "node-cli"
  }
}
