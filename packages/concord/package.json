{
  "name": "@ternent/concord",
  "version": "0.3.0",
  "description": "Shared, signed, partly private documents built from an application's events",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternent/core.git",
    "directory": "packages/concord"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "publint --strict --pack false",
    "check": "pnpm --filter @ternent/concord... run build && pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:artifact"
  },
  "dependencies": {
    "@scure/base": "2.4.0",
    "@ternent/armour": "workspace:^",
    "@ternent/identity": "workspace:^",
    "@ternent/ledger": "workspace:^",
    "age-encryption": "0.3.1"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
