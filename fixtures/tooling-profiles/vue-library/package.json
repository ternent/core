{
  "name": "@ternent-fixtures/vue-library",
  "version": "0.0.0-pilot.0",
  "private": true,
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "ternent-tooling validate . --built",
    "check": "vp run verify"
  },
  "devDependencies": {
    "@ternent/tooling": "workspace:*",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin-vue": "8.0.1",
    "vite-plus": "1.7.0",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  },
  "peerDependencies": {
    "vue": "3.5.46"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "ternent": {
    "profile": "vue-library"
  }
}
