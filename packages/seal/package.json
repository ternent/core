{
  "name": "@ternent/seal",
  "version": "0.5.0",
  "description": "Detached Ed25519 proofs over content hashes",
  "keywords": [
    "cli",
    "integrity",
    "proof",
    "seal",
    "signature"
  ],
  "homepage": "https://github.com/ternent/core/tree/main/packages/seal",
  "bugs": {
    "url": "https://github.com/ternent/core/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ternent/core.git",
    "directory": "packages/seal"
  },
  "bin": {
    "seal": "./bin/seal"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "llms.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint --type-aware .",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vp test run",
    "build": "vp pack",
    "check:artifact": "publint --strict --pack false",
    "check": "pnpm --filter @ternent/seal... run build && pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:artifact"
  },
  "dependencies": {
    "@scure/base": "2.4.0",
    "@ternent/identity": "workspace:^"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
